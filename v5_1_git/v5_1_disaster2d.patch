+  for (const a of assets) {
+    const yy = await readText('sounds/' + a + '/' + a + '.yy');
+    let dur = null, ext = '';
+    if (yy) {
+      const dm = /"duration":([0-9.]+)/.exec(yy); if (dm) dur = parseFloat(dm[1]);
+      const sm = /"soundFile":"([^"]+)"/.exec(yy); if (sm) ext = sm[1].split('.').pop();
