+  p.add.forEach(s => lines.push('  · sounds/' + s.asset + '/ (' + s.ext + ', ' + mmss(s.dur) + ') + registro .yyp'));
+  p.repl.forEach(s => lines.push('  · audio nuevo de ' + s.asset + ' (' + s.ext + ', ' + mmss(s.dur) + ')'));
+  lines.push('  · scr_lms.gml: lista de ' + LMS.songs.length + ' canción(es)' + (LMS.serverOk ? ' + macros del show' : ''));
+  if (LMS.serverOk) lines.push('  · Server.h: LMS_SONG_SEC = { ' + LMS.songs.map(s => Math.max(1, Math.round(s.dur || 282))).join(', ') + ' }');
+  lines.push('\nDespués: F5 (cliente) y RECOMPILAR EL SERVER. ¿Continuar?');
+  if (!confirm(lines.join('\n'))) return;
+
+  const stamp = new Date().toISOString().replace(/[:T]/g, '-').slice(0, 16);
+  const undo = [];
+  try {
+    const bdir = await ensureDir('_backups_animeditor/' + stamp);
+
+    // 1) sonidos: carpetas nuevas / audios reemplazados
+    const tmpl = await readText('sounds/mus_undefeatable/mus_undefeatable.yy');
+    if (!tmpl) { toast('No encuentro sounds/mus_undefeatable/mus_undefeatable.yy (plantilla).', 'err'); return; }
+    for (const s of p.add.concat(p.repl)) {
+      const dirRel = 'sounds/' + s.asset + '/';
+      const yyRel = dirRel + s.asset + '.yy';
+      const audRel = dirRel + s.asset + '.' + s.ext;
+      const yyNew = buildSoundYy(tmpl, s.asset, s.ext, s.dur);
+      if (s.repl) await lmsBackup(yyRel, bdir, undo, false);
+      await lmsWrite(yyRel, yyNew);
+      // audio viejo de otra extensión: respaldar y quitar (mejor esfuerzo)
+      if (s.repl) {
+        for (const e2 of ['mp3', 'ogg', 'wav']) {
+          if (e2 === s.ext) continue;
+          const oldRel = dirRel + s.asset + '.' + e2;
+          try { const fh = await fsWalkFile(oldRel); const f = await fh.getFile(); const d = await f.arrayBuffer();
+            const bh = await bdir.getFileHandle(oldRel.replace(/\//g, '__'), { create: true });
+            const w2 = await bh.createWritable(); await w2.write(d); await w2.close();
+            undo.push({ rel: oldRel, backup: '_backups_animeditor/' + bdir.name + '/' + oldRel.replace(/\//g, '__'), binary: true });
+            try { const dh = await fsWalkDir('sounds/' + s.asset); await dh.removeEntry(s.asset + '.' + e2); } catch (e) { }
+          } catch (e) { /* no existía */ }
+        }
+      } else {
+        undo.push({ rel: yyRel, backup: null });
+        undo.push({ rel: audRel, backup: null, binary: true });
+      }
+      await lmsWrite(audRel, s.bytes);
+    }
+
+    // 2) registro .yyp (solo canciones nuevas)
+    const newAssets = p.add.filter(s => !s.repl).map(s => s.asset);
+    if (newAssets.length) {
+      const yypName = await lmsYypName();
+      if (!yypName) { toast('No encuentro el .yyp del proyecto.', 'err'); return; }
+      let yyp = await readText(yypName);
+      let changed = false;
+      for (const a of newAssets) {
+        if (yyp.indexOf('"name":"' + a + '"') >= 0) continue;
+        const entry = '    {"id":{"name":"' + a + '","path":"sounds/' + a + '/' + a + '.yy",},},\n';
+        const mres = /"resources"\s*:\s*\[\s*\n/.exec(yyp);
+        if (!mres) { toast('No encuentro la lista "resources" del .yyp: no lo toco.', 'err'); return; }
+        yyp = yyp.slice(0, mres.index + mres[0].length) + entry + yyp.slice(mres.index + mres[0].length);
+        changed = true;
+      }
+      if (changed) {
+        if (!lmsYypOk(yyp)) { toast('El .yyp nuevo NO validaría: no se escribe.', 'err'); return; }
+        await lmsBackup(yypName, bdir, undo, false);
+        await lmsWrite(yypName, yyp);
+      }
+    }
+
+    // 3) scr_lms.gml: lista + macros
+    {
+      let gml = await readText(REL_LMS);
+      await lmsBackup(REL_LMS, bdir, undo, false);
+      gml = gml.replace(/global\.lmsSongs\s*=\s*\[[^\]]*\]/, 'global.lmsSongs = [' + LMS.songs.map(s => s.asset).join(', ') + ']');
+      if (p.mac) {
+        let r = C.setMacro(gml, 'LMS_BLOCK_CHANCE', { value: Math.round(LMS.mac.chance) }); if (r.changed) gml = r.gml;
+        r = C.setMacro(gml, 'LMS_BLOCK_INVULN', { value: Math.round(LMS.mac.invuln_s * 60) }); if (r.changed) gml = r.gml;
+        r = C.setMacro(gml, 'LMS_STUN_BONUS', { value: LMS.mac.stun }); if (r.changed) gml = r.gml;
+        r = C.setMacro(gml, 'LMS_HP', { value: Math.round(LMS.mac.hp) }); if (r.changed) gml = r.gml;
+        gml = gml.replace(/^#macro\s+LMS_SPIN_STUN\s+\w+/m, (ln) => ln.replace(/(LMS_SPIN_STUN\s+)\w+/, '$1' + (LMS.mac.spin ? 'true' : 'false')));
+      }
+      await lmsWrite(REL_LMS, gml);
+    }
+
+    // 4) Server.h: lista de duraciones
+    if (LMS.serverOk) {
+      let srv = await readText(REL_SRVH);
+      await lmsBackup(REL_SRVH, bdir, undo, false);
+      const durs = LMS.songs.map(s => Math.max(1, Math.round(s.dur || 282)));
+      srv = srv.replace(/#define LMS_SONG_COUNT \d+/, '#define LMS_SONG_COUNT ' + LMS.songs.length)
+        .replace(/static const uint16_t LMS_SONG_SEC\[LMS_SONG_COUNT\] = \{[^}]*\};/,
+          'static const uint16_t LMS_SONG_SEC[LMS_SONG_COUNT] = { ' + durs.join(', ') + ' };');
+      await lmsWrite(REL_SRVH, srv);
+    }
+
+    LMS.undoStack.push(undo);
+    LMS.songs.forEach(s => { s.isNew = false; s.repl = false; delete s.bytes; delete s.fileName; });
+    await scanLms(); renderLms();
+    toast('Show LMS escrito ✓ ' + LMS.songs.length + ' canción(es).\nRecompila el juego (F5) Y el server (compilar_server.bat).');
+  } catch (e) {
+    toast('Error al escribir: ' + e.message, 'err');
+  }
+}
+
+async function undoLms() {
+  const g = LMS.undoStack.pop();
+  if (!g) { toast('Nada que deshacer.'); return; }
+  try {
+    for (const it of g) {
+      if (it.backup) {
+        const fh = await fsWalkFile(it.backup);
+        const f = await fh.getFile();
+        const data = it.binary ? await f.arrayBuffer() : await f.text();
+        await lmsWrite(it.rel, data);
+      } else {
+        // archivo nuevo: quitarlo (mejor esfuerzo)
+        try {
+          const parts = normPath(it.rel).split('/');
+          const fn = parts.pop();
+          const dh = await fsWalkDir(parts.join('/'));
+          await dh.removeEntry(fn);
+        } catch (e) { }
+      }
+    }
+  } catch (e) { toast('Error al deshacer: ' + e.message, 'err'); return; }
+  await scanLms(); renderLms();
+  toast('Deshecho: restaurado desde la copia.');
+}
+
+// ------------------------------------------------------------------
+// integración
+// ------------------------------------------------------------------
+
+function bindLms() {
+  if (LMS.bound) return;
+  LMS.bound = true;
+  $('#lms-add').addEventListener('change', e => { addLmsSongs(Array.from(e.target.files || [])); e.target.value = ''; });
+  $('#lms-write').addEventListener('click', writeLms);
+  $('#lms-undo').addEventListener('click', undoLms);
+}
+
+window.enterLms = async function () {
+  bindLms();
+  if (!LMS.scanned) { await scanLms(); }
+  renderLms();
+};
+
+window.__onProjectScan = (function (prev) {
+  return function () {
+    LMS.scanned = false; LMS.songs = []; LMS.macOrig = null; LMS.mac = null;
+    if (typeof prev === 'function') prev();
+  };
+})(window.__onProjectScan);
+
+})();
