+    const yy = buildSpriteYyG(name, w, h, xo, yo, oe, speed, n, parentName, parentPath, tex);
+    await arteWriteFile('sprites/' + name + '/' + name + '.yy', new Blob([yy], { type: 'text/plain' }));
+    meta = C.parseSpriteYy(yy);
+    undoGroup.push({ rel: 'sprites/' + name + '/' + name + '.yy', backup: null });
+    return { meta, created: true };
+  }
