+async function lmsWrite(rel, data) {
+  const parts = normPath(rel).split('/').filter(Boolean);
+  let dh = S.rootHandle;
+  for (let i = 0; i < parts.length - 1; i++) dh = await dh.getDirectoryHandle(parts[i], { create: true });
+  const fh = await dh.getFileHandle(parts[parts.length - 1], { create: true });
+  const w = await fh.createWritable();
+  await w.write(data);
+  await w.close();
+}
+
+async function lmsBackup(rel, bdir, undo, binary) {
+  try {
+    const fh = await fsWalkFile(rel);
+    const f = await fh.getFile();
+    const data = binary ? await f.arrayBuffer() : await f.text();
+    const bname = rel.replace(/\//g, '__');
+    const bfh = await bdir.getFileHandle(bname, { create: true });
+    const w = await bfh.createWritable(); await w.write(data); await w.close();
+    undo.push({ rel, backup: '_backups_animeditor/' + bdir.name + '/' + bname, binary: !!binary });
+    return data;
+  } catch (e) { undo.push({ rel, backup: null }); return null; }
+}
+
+async function lmsYypName() {
+  const dh = await fsWalkDir('');
+  for await (const [n, h] of dh.entries())
+    if (h.kind === 'file' && n.endsWith('.yyp')) return n;
+  return null;
+}
+
+function lmsYypOk(t) {
+  try { JSON.parse(String(t).replace(/^\uFEFF/, '').replace(/,(\s*[}\]])/g, '$1')); return true; }
+  catch (e) { return false; }
+}
+
+// .yy de sonido a partir del de mus_undefeatable (campos probados del juego)
+function buildSoundYy(tmpl, asset, ext, dur) {
+  let yy = tmpl.split('mus_undefeatable').join(asset);
+  yy = yy.replace(new RegExp('"' + asset + '\\.[A-Za-z0-9]+"'), '"' + asset + '.' + ext + '"');
+  yy = yy.replace(/"duration":[0-9.]+/, '"duration":' + (Math.round(dur * 10000) / 10000));
+  return yy;
+}
+
+// duración real del audio (Web Audio decodifica mp3/ogg/wav)
+async function decodeDuration(file) {
+  try {
+    if (!LMS.audioCtx) LMS.audioCtx = new (window.AudioContext || window.webkitAudioContext)();
+    const buf = await file.arrayBuffer();
+    const ab = await LMS.audioCtx.decodeAudioData(buf.slice(0));
+    return { dur: ab.duration, bytes: buf };
+  } catch (e) { return null; }
+}
+
+// ------------------------------------------------------------------
+// escaneo del proyecto
