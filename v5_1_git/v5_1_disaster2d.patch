+  const gc = await readText(REL_GAMEC);
+  LMS.gamePatched = gc != null && /lms_song/.test(gc);
+  const nsg = await readText(REL_NSG);
+  LMS.nsgPatched = nsg != null && /scr_lms_play_song/.test(nsg);
+}
