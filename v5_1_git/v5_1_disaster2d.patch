+  async function writeFramesIntoSprite(name, frameMap, w, h, bdir, stamp, undoGroup) {
+    // frameMap: {frameIdx: canvas} — escribe PNG raíz + layers con respaldo
+    const meta = await svMeta(name);
+    if (!meta) return { name, created: false, ok: false };
+    for (const k of Object.keys(frameMap)) {
+      const i = parseInt(k, 10);
+      const fg = meta.frames[i];
+      if (!fg) continue;
+      const cv = frameMap[k];
+      const blob = await new Promise(res => cv.toBlob(res, 'image/png'));
+      const targets = ['sprites/' + name + '/' + fg + '.png'];
+      for (const lg of meta.layers) targets.push('sprites/' + name + '/layers/' + fg + '/' + lg + '.png');
+      for (const rel of targets) {
+        let backed = false;
+        try {
+          const fh = await fsWalkFile(rel);
+          const orig = await (await fh.getFile()).arrayBuffer();
+          const bfh = await bdir.getFileHandle(name + '_' + i + '_' + rel.split('/').pop(), { create: true });
+          const bw = await bfh.createWritable(); await bw.write(orig); await bw.close();
+          backed = true;
+        } catch (e) { }
+        await arteWriteFile(rel, blob);
+        undoGroup.push({ rel, backup: backed ? '_backups_animeditor/' + stamp + '/' + name + '_' + i + '_' + rel.split('/').pop() : null });
+      }
+    }
+    return { name, created: false, ok: true };
+  }
+
+  async function svEnsureSprite(name, n, w, h, xo, yo, oe, speed, parentName, parentPath, tex, bdir, stamp, undoGroup) {
