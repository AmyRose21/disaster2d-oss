diff --git a/betterserver-oss/disasterserver/states/Game.c b/betterserver-oss/disasterserver/states/Game.c
index bcaac244..5ff31b1d 100644
--- a/betterserver-oss/disasterserver/states/Game.c
+++ b/betterserver-oss/disasterserver/states/Game.c
@@ -465,6 +465,7 @@ bool game_demonize(Server* server, PeerData* data)
                 SET_FLAG(data->plr.flags, PLAYER_DEMONIZED);
                 
                 data->plr.stats.rings = 0;
+                data->plr.dedemon_progress = 0; /* v2.11: rescate fresco al demonizarse */
 
                 // reset cooldown (v2.1.3: POR JUGADOR, en el demonizado)
                 switch (data->surv_char)
@@ -1007,6 +1008,7 @@ bool game_state_handletcp(PeerData* v, Packet* packet)
 
                         DEL_FLAG(target->plr.flags, PLAYER_DEMONIZED);
                         SET_FLAG(target->plr.flags, PLAYER_REVIVED);
+                        target->plr.dedemon_progress = 0;
 
                         Packet pack;
                         PacketCreate(&pack, SERVER_VANILLA_DEDEMONIZE);
@@ -1017,6 +1019,105 @@ bool game_state_handletcp(PeerData* v, Packet* packet)
                         break;
                 }
 
+                case CLIENT_VANILLA_DEDEMONIZE_PROGRESS:
+                {
+                        /* v2.11 — RESCATE DE ESBIRRO "como revivir a un
+                         * caido": Vanilla mantiene ABAJO sobre un esbirro
+                         * ATURDIDO (su estado por red es DEAD; lo valida su
+                         * cliente en scr_survivor_revive, igual que el revive
+                         * normal valida el PLAYER_DEAD) con 15+ anillos.
+                         * Mismo patron que CLIENT_REVIVAL_PROGRESS: el
+                         * progreso vive AQUI (plr.dedemon_progress y se
+                         * CONSERVA si suelta el boton a mitad, como la barra
+                         * del caido), la barra es la misma
+                         * (SERVER_REVIVAL_PROGRESS + SERVER_REVIVAL_STATUS)
+                         * y al llenarse hace exactamente lo del
+                         * CLIENT_VANILLA_DEDEMONIZE de arriba: limpiar
+                         * PLAYER_DEMONIZED + marcar PLAYER_REVIVED ("a 1
+                         * caida de re-demonizarse"). Los 15 anillos los
+                         * cobra el cliente de Vanilla al recibir el
+                         * SERVER_VANILLA_DEDEMONIZE (lock dedemonTarget). */
+                        AssertOrDisconnect(v->server, v->in_game);
+                        AssertOrDisconnect(v->server, v->id != v->server->game.exe);
+                        AssertOrDisconnect(v->server, v->surv_char == CH_VANILLA);
+
+                        if (v->server->game.end > 0)
+                                break;
+
+                        PacketRead(pid, packet, packet_read16, uint16_t);
+                        PacketRead(rings, packet, packet_read8, uint8_t);
+
+                        PeerData* target = server_find_peer(v->server, pid);
+
+                        if (target == NULL)
+                                break;
+
+                        if (target == v || !target->in_game)
+                                break;
+
+                        if (!(target->plr.flags & PLAYER_DEMONIZED))
+                                break;
+
+                        if (rings < 15)
+                                break;
+
+                        /* misma tolerancia de distancia que el handler
+                         * instantaneo de la v2 (tocando al esbirro) */
+                        if (vector2_dist(&target->plr.pos, &v->plr.pos) > 150)
+                                break;
+
+                        Packet pack;
+
+                        if (target->plr.dedemon_progress <= 0)
+                        {
+                                /* misma senal que abre la barra del revive normal */
+                                PacketCreate(&pack, SERVER_REVIVAL_STATUS);
+                                PacketWrite(&pack, packet_write8, 1);
+                                PacketWrite(&pack, packet_write16, target->id);
+                                server_broadcast(v->server, &pack, true);
+                        }
+
+                        /* base 0.03 por paquete (30 paq/s = ~1.1 s, cabe
+                         * comodo en el stun de 3.5 s de Chocola) + bonus
+                         * por anillos de sobra (tope +25, como el revive
+                         * del caido acelera con anillos) */
+                        {
+                                int bonus = rings - 15;
+
+                                if (bonus > 25)
+                                        bonus = 25;
+
+                                target->plr.dedemon_progress += 0.03 + 0.002 * bonus;
+                        }
+
+                        if (target->plr.dedemon_progress < 1)
+                        {
+                                PacketCreate(&pack, SERVER_REVIVAL_PROGRESS);
+                                PacketWrite(&pack, packet_write16, target->id);
+                                PacketWrite(&pack, packet_writedouble, target->plr.dedemon_progress);
+                                server_broadcast(v->server, &pack, false);
+                                break;
+                        }
+
+                        /* completado: rescate! mismo efecto que el handler
+                         * instantaneo + cerrar la barra del revive */
+                        target->plr.dedemon_progress = 0;
+                        DEL_FLAG(target->plr.flags, PLAYER_DEMONIZED);
+                        SET_FLAG(target->plr.flags, PLAYER_REVIVED);
+
+                        PacketCreate(&pack, SERVER_REVIVAL_STATUS);
+                        PacketWrite(&pack, packet_write8, 0);
+                        PacketWrite(&pack, packet_write16, target->id);
+                        server_broadcast(v->server, &pack, true);
+
+                        PacketCreate(&pack, SERVER_VANILLA_DEDEMONIZE);
+                        PacketWrite(&pack, packet_write16, target->id);
+                        server_broadcast(v->server, &pack, true);
+
+                        Info("%s (id %d) rescued from demonization by Vanilla!", target->nickname.value, target->id);
+                        break;
+                }
+
 
                 /* ============================================================
                  *  v2.2 (TTB) — habilidades de los personajes rescatados
diff --git a/betterserver-oss/include/Packet.h b/betterserver-oss/include/Packet.h
index f733c00e..723af21f 100644
--- a/betterserver-oss/include/Packet.h
+++ b/betterserver-oss/include/Packet.h
@@ -211,7 +211,18 @@ typedef enum
            choque reporta nid + que componentes de velocidad invertir
            + la posicion del primer solape. Mismo orden que el enum
            del cliente (net_packets.gml). */
-        CLIENT_BLAZE_FIREBALL_BOUNCE
+        CLIENT_BLAZE_FIREBALL_BOUNCE,
+
+        /* v2.11 — Vanilla: progreso del RESCATE DE ESBIRRO (mismo
+           sistema que CLIENT_REVIVAL_PROGRESS pero para un esbirro
+           ATURDIDO, cuyo stun viaja como estado DEAD): Vanilla encima
+           manteniendo ABAJO con 15+ anillos. El server acumula el
+           progreso (plr.dedemon_progress), reenvia la MISMA barra
+           (SERVER_REVIVAL_PROGRESS) y al completarlo hace lo que
+           hacia CLIENT_VANILLA_DEDEMONIZE: limpiar PLAYER_DEMONIZED +
+           marcar PLAYER_REVIVED. Mismo orden que el enum del cliente
+           (net_packets.gml). */
+        CLIENT_VANILLA_DEDEMONIZE_PROGRESS
 } PacketType;
 
 typedef struct
diff --git a/betterserver-oss/include/Player.h b/betterserver-oss/include/Player.h
index 5ceba729..c2ab19fb 100644
--- a/betterserver-oss/include/Player.h
+++ b/betterserver-oss/include/Player.h
@@ -48,6 +48,7 @@ typedef struct
 	double		death_timer;
 	double		revival;
 	int32_t		revival_init[5];
+	double		dedemon_progress; /* v2.11: progreso del rescate de Vanilla (revive-style) */
 
 	uintptr_t	data[4]; /* Can be used as pointer/data field */
 	Vector2		start_pos;
diff --git a/objects/obj_chocola/Step_0.gml b/objects/obj_chocola/Step_0.gml
index 41a80cb6..01bd32d3 100644
--- a/objects/obj_chocola/Step_0.gml
+++ b/objects/obj_chocola/Step_0.gml
@@ -86,7 +86,9 @@ switch(mode)
                 if(distance_to_object(targetInst) < 20)
                 {
                         // GOLPE: la autoridad manda la senal de stun al nid
-                        // del exe (5 s en la caza grande, 1.5 s en la mini)
+                        // del OBJETIVO (5 s en la caza grande al exe; en la
+                        // mini 2.5 s al exe o 3.5 s a un esbirro: lo decide
+                        // el receptor en net_state_game — v2.11)
                         if(authority)
                         {
                                 if(huntSmall)
@@ -201,14 +203,25 @@ switch(mode)
                 sprite_index = spr_vanilla_chocola_Idle;
                 image_speed = 0.3;
 
-                // (cliente de Cream) ataque cercano al exe: 33%, stun de
-                // 1.5 s, no si tiene i-frames. Cumplida la mision (stun o
-                // bloqueo), Chocola vuelve con Vanilla.
+                // (cliente de Cream) ataque cercano: 33%, stun de 2.5 s al
+                // exe (3.5 s a un ESBIRRO demonizado: v2.11, Chocola
+                // tambien los detecta mientras custodia), no si tienen
+                // i-frames. Cumplida la mision (stun o bloqueo), Chocola
+                // vuelve con Vanilla. El objetivo es el MAS CERCANO entre
+                // el exe y los esbirros a rango de embestida.
                 if(targetInst == global.player && global.character == CHARACTER_CREAM && guardTimer <= 0)
                 {
-                        var _gexe = scr_chocola_find_exe();
+                        var _gtgt = scr_chocola_find_exe();
 
-                        if(_gexe != noone && !_gexe.isHurt && distance_to_object(_gexe) < VANILLA_CHOCOLA_ATTACK_RANGE)
+                        if(_gtgt != noone && (_gtgt.isHurt || distance_to_object(_gtgt) >= VANILLA_CHOCOLA_ATTACK_RANGE))
+                                _gtgt = noone;
+
+                        var _gmin = scr_chocola_find_minion(VANILLA_CHOCOLA_ATTACK_RANGE);
+
+                        if(_gmin != noone && (_gtgt == noone || distance_to_object(_gmin) < distance_to_object(_gtgt)))
+                                _gtgt = _gmin;
+
+                        if(_gtgt != noone)
                         {
                                 if(random(100) < VANILLA_CHOCOLA_ATTACK_CHANCE)
                                 {
@@ -217,10 +230,10 @@ switch(mode)
                                         fromGuard = true;
                                         authority = true;
                                         huntTimer = 0;
-                                        targetInst = _gexe;
+                                        targetInst = _gtgt;
 
                                         // v2.1: anuncia la embestida por
-                                        // red (snd_chocola_dive): el exe
+                                        // red (snd_chocola_dive): el objetivo
                                         // y los demas la ven venir
                                         audio_play_sound(snd_chocola_dive, 0, false);
                                         net_sound_emit(snd_chocola_dive);
